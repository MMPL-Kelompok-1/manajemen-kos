# Salin menjadi .env lalu isi nilainya. Jangan commit file .env.

# Koneksi PostgreSQL
DATABASE_URL="postgresql://user:password@localhost:5432/kosanku"

# Kunci tanda tangan cookie sesi. Wajib di production.
# Buat dengan: openssl rand -base64 32
SESSION_SECRET=""

# Akun pemilik yang dibuat oleh `npm run db:seed`
OWNER_EMAIL="owner@example.com"
OWNER_PASSWORD=""
OWNER_NAME="Pemilik Kos"
OWNER_PHONE="081234567890"

# Rekening tujuan transfer yang ditampilkan ke penghuni. Wajib di production.
BANK_NAME=""
BANK_ACCOUNT_NUMBER=""
BANK_ACCOUNT_NAME=""
